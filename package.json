{
  "name": "atpost-web",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "e2e": "playwright test",
    "e2e:commerce": "playwright test e2e/commerce.spec.ts",
    "e2e:admin": "playwright test e2e/admin.spec.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "1.53.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.19",
    "turbo": "^2.1.0",
    "typescript": "^5.8.2"
  }
}
