# @atpost/* scoped packages resolve from AWS CodeArtifact.
# Authenticate before install/publish (writes the token into this file's
# registry line, or use a project-local ~/.npmrc):
#
#   aws codeartifact login --tool npm \
#     --domain atpost --repository atpost-web --region ap-south-1
#
# Replace <ACCOUNT_ID> with the real AWS account once CodeArtifact is created
# (Terraform module to be added under modernsmapp/infra/terraform).
@atpost:registry=https://atpost-<ACCOUNT_ID>.d.codeartifact.ap-south-1.amazonaws.com/npm/atpost-web/
//atpost-<ACCOUNT_ID>.d.codeartifact.ap-south-1.amazonaws.com/npm/atpost-web/:always-auth=true
