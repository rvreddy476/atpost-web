{
  "name": "@atpost/form",
  "version": "0.1.0",
  "description": "atPost schema-driven form engine — validates an AttributeSchema's values, builds a zod resolver, parses money. Pure TypeScript, no React.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings=0"
  },
  "dependencies": {
    "@atpost/types": "workspace:*"
  },
  "peerDependencies": {
    "zod": ">=4"
  },
  "devDependencies": {
    "@atpost/config": "workspace:*",
    "typescript": "^5.8.2",
    "vitest": "2.1.9",
    "zod": "^4.5.4"
  },
  "files": [
    "src"
  ]
}
