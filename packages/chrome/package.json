{
  "name": "@momentum/chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The frame every social surface wears — header, search, the destination strip, the identity rail and the suggestions rail. The one package allowed to touch @atpost/api-client, because the chrome is what draws the viewer.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@atpost/api-client": "workspace:*",
    "@momentum/brand": "workspace:*",
    "@momentum/content": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@atpost/config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "2.1.9"
  },
  "files": [
    "src"
  ]
}
