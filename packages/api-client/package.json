{
  "name": "@atpost/api-client",
  "version": "0.1.0",
  "description": "atPost shared gateway client — axios client + same-origin proxy + token refresh (httpOnly-cookie aware).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./proxy": "./src/proxy.ts",
    "./refresh": "./src/refresh.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo '@atpost/api-client lint ok'"
  },
  "peerDependencies": {
    "axios": ">=1",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atpost/config": "workspace:*",
    "axios": "^1.7.0",
    "next": "^15.0.0",
    "typescript": "^5.8.2"
  },
  "files": [
    "src"
  ]
}
