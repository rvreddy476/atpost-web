  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@atpost/types": "workspace:*",
    "@momentum/interactions": "workspace:*",
    "@momentum/player": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.400.0"
  },
  "devDependencies": {
    "@atpost/config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  },
  "files": [
    "src"
  ]
