{
  "name": "@momentum/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The post card, media rendering, the blurhash placeholder, the infinite pager and the empty/error/loading states. Composes @momentum/player and @momentum/interactions; performs no network of its own.",
