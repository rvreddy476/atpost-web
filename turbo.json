{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ADMIN_BASE_PATH", "ADMIN_IMAGE_ORIGINS", "NEXT_PUBLIC_ADMIN_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ADMIN_BASE_PATH", "ADMIN_IMAGE_ORIGINS", "NEXT_PUBLIC_ADMIN_*"]
    }
  }
}
