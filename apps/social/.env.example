# Server-side: where the same-origin proxy/refresh handlers forward to.
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081

# Browser axios base — set to this zone's basePath so /v1 + /api/proxy resolve
# to THIS zone under Multi-Zones composition (edge routes /shop/* here).
NEXT_PUBLIC_API_BASE_URL=/social
