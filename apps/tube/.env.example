# Server-side: where the same-origin proxy/refresh handlers forward to.
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081

# Browser axios base — set to this zone's basePath so /v1 + /api/proxy resolve
# to THIS zone under Multi-Zones composition (the shell routes /tube/* here).
NEXT_PUBLIC_API_BASE_URL=/tube

# Absolute origin the shell is served from, used only by `generateMetadata`
# to build canonical and Open Graph URLs for a shared video or channel link.
# A relative URL is not a share link: previews resolve it against the crawler,
# not against us. Defaults to http://localhost:3000 when unset, which is right
# for development and wrong everywhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
