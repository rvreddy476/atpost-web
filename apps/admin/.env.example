# Server-side: where the same-origin proxy forwards to. Sign-in, refresh,
# step-up and sign-out all go through it to /v1/auth/admin-session/*.
API_GATEWAY_URL=http://localhost:8080

# ── Host shape (read at BUILD time) ──────────────────────────────────────────
# Unset: served under /admin (local dev, the multi-zone shell).
# "/" or empty: served at the root of its own host, e.g. admin.cleestudio.com.
# ADMIN_BASE_PATH=/

# The browser client's prefix. Derived from ADMIN_BASE_PATH when unset; only
# set it if the two must differ.
# NEXT_PUBLIC_API_BASE_URL=/admin

# Sign-in is the console's own /login page (admin-session cookies, host-only).
# NEXT_PUBLIC_ADMIN_SIGN_IN_URL is no longer read.

# Added to CSP connect-src when the browser calls the API origin directly.
# Leave unset while requests go through this app's /api/proxy.
# NEXT_PUBLIC_ADMIN_API_ORIGIN=https://api.cleestudio.com

# CSP img-src origins for product photos and documents (comma or space separated).
# ADMIN_IMAGE_ORIGINS=https://*.cleestudio.com
